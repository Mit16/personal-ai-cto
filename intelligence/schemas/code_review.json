{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "alignment_score",
    "execution_quality",
    "architecture_issues",
    "code_smells",
    "summary",
    "recommended_action"
  ],
  "properties": {
    "alignment_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "How well this commit aligns with active goals (0.0 = no alignment, 1.0 = perfect alignment)"
    },
    "execution_quality": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Technical quality of the changes"
    },
    "architecture_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of architectural concerns or violations"
    },
    "code_smells": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of code quality issues"
    },
    "summary": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief assessment of the commit"
    },
    "recommended_action": {
      "type": "string",
      "maxLength": 200,
      "description": "What should be done next"
    }
  },
  "additionalProperties": false
}
